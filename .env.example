# Copy to .env for local development.

# Postgres connection string (production / Render will set this automatically).
# Local example below matches the dev defaults in app/config.py.
DATABASE_URL=postgresql+psycopg2://studentapi:studentapi@localhost:5432/student_api_test

# Or, for a zero-setup local SQLite dev database:
# DATABASE_URL=sqlite:///./student_api.db

# Master key for admin endpoints. Use a long random value in production.
MASTER_KEY=dev-master-key-change-me
